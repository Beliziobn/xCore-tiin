rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'dmedoquessua@gmail.com' ||
          request.auth.token.email == 'socienciadaeduca2018@gmail.com'
        ))
      );
    }

    // ==========================================
    // Collection: /applications/{applicationId}
    // Cross-device cloud homologation for directors & teachers
    // ==========================================
    match /applications/{applicationId} {
      allow read: if true;
      allow create: if isValidId(applicationId);
      allow update: if true;
      allow delete: if true;
    }

    // ==========================================
    // Collection: /quickRequests/{requestId}
    // Fast citizen & teacher service requests
    // ==========================================
    match /quickRequests/{requestId} {
      allow read: if true;
      allow create: if isValidId(requestId);
      allow update: if true;
      allow delete: if true;
    }

    // ==========================================
    // Collection: /schools/{schoolId}
    // School directory & director assignments
    // ==========================================
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if true;
    }

    // ==========================================
    // Collection: /teachers/{teacherId}
    // Teacher rosters
    // ==========================================
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if true;
    }

    // ==========================================
    // Collection: /users/{userId}
    // Institutional user accounts
    // ==========================================
    match /users/{userId} {
      allow read: if true;
      allow create: if isValidId(userId);
      allow update: if true;
      allow delete: if true;
    }

    // ==========================================
    // Collection: /admins/{adminId}
    // ==========================================
    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    // ==========================================
    // Collection: /audit_logs/{logId}
    // Audit logs
    // ==========================================
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId);
      allow update, delete: if false;
    }

    // ==========================================
    // Collection: /students/{studentId}
    // ==========================================
    match /students/{studentId} {
      allow read: if true;
      allow write: if true;
    }

    // ==========================================
    // Collection: /grades/{gradeId}
    // ==========================================
    match /grades/{gradeId} {
      allow read: if true;
      allow write: if true;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }
  }
}
