rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Helper Functions & Validation Blueprints
    // Note: SIGRE currently authenticates institutional accounts via custom
    // email/password verification in-app (without mandatory Firebase Auth tokens).
    // All list queries enforce strict upper bounds via request.query.limit
    // to prevent unbounded collection scans and protect daily read quotas.
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && !id.matches('.*(/|\\.\\.).*');
    }

    function hasBoundedQueryLimit(maxLimit) {
      return request.query.limit is int && request.query.limit > 0 && request.query.limit <= maxLimit;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email_verified == true && (
          request.auth.token.email == 'dmedoquessua@gmail.com' ||
          request.auth.token.email == 'beliziodos20@gmail.com' ||
          request.auth.token.email == 'socienciadaeduca2018@gmail.com'
        ))
      );
    }

    // Prevents oversized/malformed payloads and recursive registrationData nesting bombs
    function isBoundedDocument() {
      return request.resource.data is map
        && request.resource.data.keys().size() > 0
        && request.resource.data.keys().size() <= 160
        && (
          !('registrationData' in request.resource.data)
          || !(request.resource.data.registrationData is map)
          || !('registrationData' in request.resource.data.registrationData)
        );
    }

    function hasSafeSchoolLogo() {
      return !('logoSvg' in request.resource.data)
        || (
          request.resource.data.logoSvg is string
          && request.resource.data.logoSvg.size() <= 32768
          && !request.resource.data.logoSvg.matches('(?i).*(<script|<foreignObject|<iframe|javascript:).*')
        );
    }

    function isValidApplicationWrite(applicationId) {
      return isValidId(applicationId)
        && isBoundedDocument()
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 180))
        && (!('status' in request.resource.data) || request.resource.data.status in ['pendente', 'aprovado', 'rejeitado']);
    }

    function isValidSchoolWrite(schoolId) {
      return isValidId(schoolId)
        && isBoundedDocument()
        && hasSafeSchoolLogo()
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 200));
    }

    function isValidEntityWrite(docId) {
      return isValidId(docId) && isBoundedDocument();
    }

    // ==========================================
    // Collection: /applications/{applicationId} (limit <= 50)
    // ==========================================
    match /applications/{applicationId} {
      allow get: if isValidId(applicationId);
      allow list: if hasBoundedQueryLimit(50);
      allow create, update: if isValidApplicationWrite(applicationId);
      allow delete: if isValidId(applicationId);
    }

    // ==========================================
    // Collection: /quickRequests/{requestId} (limit <= 50)
    // ==========================================
    match /quickRequests/{requestId} {
      allow get: if isValidId(requestId);
      allow list: if hasBoundedQueryLimit(50);
      allow create, update: if isValidEntityWrite(requestId);
      allow delete: if isValidId(requestId);
    }

    // ==========================================
    // Collection: /schools/{schoolId} (limit <= 100)
    // ==========================================
    match /schools/{schoolId} {
      allow get: if isValidId(schoolId);
      allow list: if hasBoundedQueryLimit(100);
      allow create, update: if isValidSchoolWrite(schoolId);
      allow delete: if isValidId(schoolId);
    }

    // ==========================================
    // Collection: /directors/{directorId} (limit <= 50)
    // ==========================================
    match /directors/{directorId} {
      allow get: if isValidId(directorId);
      allow list: if hasBoundedQueryLimit(50);
      allow create, update: if isValidEntityWrite(directorId);
      allow delete: if isValidId(directorId);
    }

    // ==========================================
    // Collection: /dme_staff/{staffId} (limit <= 50)
    // ==========================================
    match /dme_staff/{staffId} {
      allow get: if isValidId(staffId);
      allow list: if hasBoundedQueryLimit(50);
      allow create, update: if isValidEntityWrite(staffId);
      allow delete: if isValidId(staffId);
    }

    // ==========================================
    // Collection: /teachers/{teacherId} (limit <= 50)
    // ==========================================
    match /teachers/{teacherId} {
      allow get: if isValidId(teacherId);
      allow list: if hasBoundedQueryLimit(50);
      allow create, update: if isValidEntityWrite(teacherId);
      allow delete: if isValidId(teacherId);
    }

    // ==========================================
    // Collection: /students/{studentId} (limit <= 50)
    // ==========================================
    match /students/{studentId} {
      allow get: if isValidId(studentId);
      allow list: if hasBoundedQueryLimit(50);
      allow create, update: if isValidEntityWrite(studentId);
      allow delete: if isValidId(studentId);
    }

    // ==========================================
    // Collection: /staff/{staffId} (limit <= 50)
    // ==========================================
    match /staff/{staffId} {
      allow get: if isValidId(staffId);
      allow list: if hasBoundedQueryLimit(50);
      allow create, update: if isValidEntityWrite(staffId);
      allow delete: if isValidId(staffId);
    }

    // ==========================================
    // Collection: /efectividade/{recordId} (limit <= 50)
    // ==========================================
    match /efectividade/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if hasBoundedQueryLimit(50);
      allow create, update: if isValidEntityWrite(recordId);
      allow delete: if isValidId(recordId);
    }

    // ==========================================
    // Collection: /declaracao_servico/{recordId} (limit <= 50)
    // ==========================================
    match /declaracao_servico/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if hasBoundedQueryLimit(50);
      allow create, update: if isValidEntityWrite(recordId);
      allow delete: if isValidId(recordId);
    }

    // ==========================================
    // Collection: /grades/{gradeId} (limit <= 50)
    // ==========================================
    match /grades/{gradeId} {
      allow get: if isValidId(gradeId);
      allow list: if hasBoundedQueryLimit(50);
      allow create, update: if isValidEntityWrite(gradeId);
      allow delete: if isValidId(gradeId);
    }

    // ==========================================
    // Collection: /attendance/{recordId} (limit <= 50)
    // ==========================================
    match /attendance/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if hasBoundedQueryLimit(50);
      allow create, update: if isValidEntityWrite(recordId);
      allow delete: if isValidId(recordId);
    }

    // ==========================================
    // Collection: /announcements/{announcementId} (limit <= 30)
    // ==========================================
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId);
      allow list: if hasBoundedQueryLimit(30);
      allow create, update: if isValidEntityWrite(announcementId);
      allow delete: if isValidId(announcementId);
    }

    // ==========================================
    // Collection: /rooms/{roomId} (limit <= 50)
    // ==========================================
    match /rooms/{roomId} {
      allow get: if isValidId(roomId);
      allow list: if hasBoundedQueryLimit(50);
      allow create, update: if isValidEntityWrite(roomId);
      allow delete: if isValidId(roomId);
    }

    // ==========================================
    // Collection: /classes/{classId} (limit <= 50)
    // ==========================================
    match /classes/{classId} {
      allow get: if isValidId(classId);
      allow list: if hasBoundedQueryLimit(50);
      allow create, update: if isValidEntityWrite(classId);
      allow delete: if isValidId(classId);
    }

    // ==========================================
    // Collection: /chatMessages/{messageId} (limit <= 50)
    // ==========================================
    match /chatMessages/{messageId} {
      allow get: if isValidId(messageId);
      allow list: if hasBoundedQueryLimit(50);
      allow create, update: if isValidEntityWrite(messageId);
      allow delete: if isValidId(messageId);
    }

    // ==========================================
    // Collection: /guias_ferias/{guiaId} (limit <= 50)
    // ==========================================
    match /guias_ferias/{guiaId} {
      allow get: if isValidId(guiaId);
      allow list: if hasBoundedQueryLimit(50);
      allow create, update: if isValidEntityWrite(guiaId);
      allow delete: if isValidId(guiaId);
    }

    // ==========================================
    // Collection: /guias_colocacao/{guiaId} (limit <= 50)
    // ==========================================
    match /guias_colocacao/{guiaId} {
      allow get: if isValidId(guiaId);
      allow list: if hasBoundedQueryLimit(50);
      allow create, update: if isValidEntityWrite(guiaId);
      allow delete: if isValidId(guiaId);
    }

    // ==========================================
    // Collection: /fichas_avaliacao/{fichaId} (limit <= 50)
    // ==========================================
    match /fichas_avaliacao/{fichaId} {
      allow get: if isValidId(fichaId);
      allow list: if hasBoundedQueryLimit(50);
      allow create, update: if isValidEntityWrite(fichaId);
      allow delete: if isValidId(fichaId);
    }

    // ==========================================
    // Collection: /cadastro_docente/{recordId} (limit <= 50)
    // ==========================================
    match /cadastro_docente/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if hasBoundedQueryLimit(50);
      allow create, update: if isValidEntityWrite(recordId);
      allow delete: if isValidId(recordId);
    }

    // ==========================================
    // Collection: /tombstones/{tombstoneId} (limit <= 50)
    // ==========================================
    match /tombstones/{tombstoneId} {
      allow get: if isValidId(tombstoneId);
      allow list: if hasBoundedQueryLimit(50);
      allow create, update: if isValidEntityWrite(tombstoneId);
      allow delete: if isValidId(tombstoneId);
    }

    // ==========================================
    // Collection: /users/{userId} (limit <= 50)
    // ==========================================
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if hasBoundedQueryLimit(50);
      allow create, update: if isValidEntityWrite(userId);
      allow delete: if isValidId(userId);
    }

    // ==========================================
    // Collection: /admins/{adminId}
    // Strictly restricted — no unauthenticated privilege escalation
    // ==========================================
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId);
      allow list: if false;
      allow write: if isAdmin() && isValidId(adminId);
    }

    // ==========================================
    // Collection: /audit_logs/{logId} (limit <= 50)
    // Immutable append-only audit logs
    // ==========================================
    match /audit_logs/{logId} {
      allow get: if isValidId(logId);
      allow list: if hasBoundedQueryLimit(50);
      allow create: if isValidEntityWrite(logId);
      allow update, delete: if false;
    }

    // ==========================================
    // Collection: /stats/{statId}
    // Single-document dashboard aggregator counters (no list queries)
    // ==========================================
    match /stats/{statId} {
      allow get: if isValidId(statId);
      allow list: if false;
      allow create, update: if isValidEntityWrite(statId);
      allow delete: if false;
    }

    // Connection test document
    match /test/connection {
      allow get: if true;
      allow list: if false;
    }
  }
}
