rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all - Least Privilege Principle (SSD)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Schema and boundary validations
    function isValidUserBase(data) {
      return data.keys().hasAll(['userId', 'email', 'firstName', 'role', 'status', 'createdAt']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.email is string && data.email.size() <= 120 &&
        data.firstName is string && data.firstName.size() <= 80 &&
        data.role in ['admin', 'diretor', 'professor', 'custom'] &&
        data.status in ['ativo', 'pendente', 'validado', 'em_analise'] &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        (!('lastName' in data) || (data.lastName is string && data.lastName.size() <= 80)) &&
        (!('scope' in data) || (data.scope in ['escola', 'administracao'])) &&
        (!('schoolRole' in data) || (data.schoolRole is string && data.schoolRole.size() <= 50)) &&
        (!('adminRole' in data) || (data.adminRole is string && data.adminRole.size() <= 50)) &&
        (!('cargoTitle' in data) || (data.cargoTitle is string && data.cargoTitle.size() <= 120)) &&
        (!('schoolName' in data) || (data.schoolName is string && data.schoolName.size() <= 150)) &&
        (!('municipalityOrDepartment' in data) || (data.municipalityOrDepartment is string && data.municipalityOrDepartment.size() <= 150)) &&
        (!('titlePrefix' in data) || (data.titlePrefix is string && data.titlePrefix.size() <= 40)) &&
        (!('accountValidated' in data) || (data.accountValidated is bool)) &&
        (!('emailVerified' in data) || (data.emailVerified is bool)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Prevent privilege escalation on user self-registration
    function isNonPrivilegedRegistration(data) {
      return data.role in ['diretor', 'professor', 'custom'] &&
        data.status in ['pendente', 'em_analise'] &&
        (!('accountValidated' in data) || data.accountValidated == false);
    }

    // Audit Log Schema Validation
    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'action', 'actorId', 'actorRole', 'details', 'timestamp']) &&
        data.id is string && data.id.size() <= 128 &&
        data.action is string && data.action.size() <= 60 &&
        data.actorId is string && data.actorId == request.auth.uid &&
        data.actorRole is string && data.actorRole.size() <= 50 &&
        data.details is string && data.details.size() <= 500 &&
        data.timestamp is string && data.timestamp.size() <= 50 &&
        (!('severity' in data) || data.severity in ['INFO', 'WARNING', 'CRITICAL']) &&
        (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128)) &&
        (!('targetType' in data) || (data.targetType is string && data.targetType.size() <= 50));
    }

    // Student Schema & Constraint Validation
    function isValidStudent(data) {
      return data.keys().hasAll(['id', 'nomeCompleto', 'schoolId', 'turma', 'classe']) &&
        data.id is string && data.id.size() <= 128 &&
        data.nomeCompleto is string && data.nomeCompleto.size() >= 3 && data.nomeCompleto.size() <= 120 &&
        data.schoolId is string && data.schoolId.size() <= 128 &&
        data.turma is string && data.turma.size() <= 50 &&
        data.classe is string && data.classe.size() <= 50 &&
        (!('numeroDocumento' in data) || (data.numeroDocumento is string && data.numeroDocumento.size() <= 30));
    }

    // Grade Constraint Validation (Angolan 0-20 scale enforced at DB level)
    function isValidGrade(data) {
      return data.keys().hasAll(['studentId', 'disciplina', 'nota', 'trimestre', 'updatedAt']) &&
        data.studentId is string && data.studentId.size() <= 128 &&
        data.disciplina is string && data.disciplina.size() <= 80 &&
        data.nota is number && data.nota >= 0 && data.nota <= 20 &&
        data.trimestre in [1, 2, 3] &&
        data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    // ==========================================
    // Collection: /users/{userId}
    // ==========================================
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      // Create: Owner creating record; if not admin, cannot elevate privileges
      allow create: if isValidId(userId) && isOwner(userId) &&
        isValidUserBase(incoming()) &&
        (isAdmin() || isNonPrivilegedRegistration(incoming()));

      // Update: Owner can update personal profile info, but cannot alter status/role without admin
      allow update: if isValidId(userId) && isValidUserBase(incoming()) && (
        isAdmin() || (
          isOwner(userId) &&
          incoming().role == existing().role &&
          incoming().status == existing().status &&
          incoming().accountValidated == existing().accountValidated
        )
      );

      // Delete: Strictly admin only
      allow delete: if isValidId(userId) && isAdmin();
    }

    // ==========================================
    // Collection: /admins/{adminId}
    // ==========================================
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ==========================================
    // Collection: /audit_logs/{logId}
    // Tamper-proof, append-only security ledger
    // ==========================================
    match /audit_logs/{logId} {
      // Read: Strictly Admins only. Regular users cannot view audit trails.
      allow get, list: if isAdmin();

      // Create: Any authenticated user can log their own action with strict schema validation
      allow create: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming());

      // Update & Delete: Strictly FORBIDDEN. Audit logs are permanently immutable.
      allow update, delete: if false;
    }

    // ==========================================
    // Collection: /students/{studentId}
    // ==========================================
    match /students/{studentId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(studentId) && isValidStudent(incoming());
      allow delete: if isAdmin();
    }

    // ==========================================
    // Collection: /grades/{gradeId}
    // ==========================================
    match /grades/{gradeId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(gradeId) && isValidGrade(incoming());
      allow delete: if isAdmin();
    }

    // Connection test document (requires authentication)
    match /test/connection {
      allow read: if isSignedIn();
    }
  }
}
