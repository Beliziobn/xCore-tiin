{
  "name": "ucore-school-platform",
  "description": "Sistema de Gestão Escolar e Avaliação Académica uCore (MED Angola)",
  "version": "1.0.0",
  "primaryLanguage": "typescript",
  "framework": "react",
  "buildTool": "vite",
  "testRunner": "node:test",
  "aiIntegration": {
    "provider": "omniroute",
    "routerConfig": "./omniroute.config.json",
    "memoryPlugin": "claude-mem",
    "taskObserver": true,
    "headroomMarginPercent": 25
  },
  "database": {
    "provider": "supabase",
    "engine": "postgresql",
    "rlsEnabled": true,
    "schemaFiles": [
      "supabase/schema.sql",
      "supabase/advanced_features.sql"
    ]
  }
}
