  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    const form = document.getElementById("signupForm");
    const formPanel = document.querySelector(".form-panel");
    const successState = document.getElementById("successState");
    const currentStepLabel = document.getElementById("currentStep");
    const submitButton = document.getElementById("submitButton");

    const stepPanels = [...document.querySelectorAll(".form-step")];
    const progressItems = [...document.querySelectorAll("[data-progress]")];

    const scopeInput = document.getElementById("scope");
    const roleInput = document.getElementById("role");

    const municipalityInput = document.getElementById("municipality");
    const schoolInput = document.getElementById("school");
    const schoolSummary = document.getElementById("schoolSummary");

    const termsInput = document.getElementById("terms");
    const termsRow = document.getElementById("termsRow");

    let currentStep = 1;

    const schools = {
      quessua: [
        {
          value: "sige-113013",
          code: "SIGE-113013",
          name: "Só Ciência da Educação",
          type: "PÚBLICA",
          location: "Quêssua · Malanje",
          stage: "Ensino primário",
          rooms: "10 salas",
          staff: "32 docentes"
        }
      ]
    };

    function refreshIcons() {
      if (window.lucide) {
        window.lucide.createIcons();
      }
    }

    function renderStep() {
      stepPanels.forEach((panel) => {
        const stepNumber = Number(panel.dataset.step);
        panel.hidden = stepNumber !== currentStep;
      });

      progressItems.forEach((item) => {
        const stepNumber = Number(item.dataset.progress);

        item.classList.toggle("is-active", stepNumber === currentStep);
        item.classList.toggle("is-complete", stepNumber < currentStep);

        if (stepNumber === currentStep) {
          item.setAttribute("aria-current", "step");
        } else {
          item.removeAttribute("aria-current");
        }
      });

      currentStepLabel.textContent = currentStep;
      refreshIcons();

      if (window.innerWidth < 1000) {
        formPanel.scrollIntoView({
          behavior: "smooth",
          block: "start"
        });
      }
    }

    function clearStepErrors(step) {
      const panel = document.querySelector(`.form-step[data-step="${step}"]`);

      if (!panel) {
        return;
      }

      const stepError = panel.querySelector("[data-step-error]");
      if (stepError) {
        stepError.hidden = true;
        stepError.textContent = "";
      }

      panel.querySelectorAll(".field.has-error").forEach((field) => {
        field.classList.remove("has-error");
      });

      panel.querySelectorAll(".is-invalid").forEach((element) => {
        element.classList.remove("is-invalid");
      });

      panel.querySelectorAll(".field-message").forEach((message) => {
        message.textContent = "";
      });

      panel.querySelectorAll(".has-error").forEach((element) => {
        element.classList.remove("has-error");
      });
    }

    function showStepError(step, message, focusElement = null) {
      const errorBox = document.querySelector(
        `.form-step[data-step="${step}"] [data-step-error]`
      );

      if (errorBox) {
        errorBox.textContent = message;
        errorBox.hidden = false;
      }

      if (focusElement) {
        focusElement.focus();
      }
    }

    function markFieldInvalid(field, message) {
      const fieldWrapper = field.closest(".field");

      if (!fieldWrapper) {
        return;
      }

      fieldWrapper.classList.add("has-error");
      field.classList.add("is-invalid");

      const fieldMessage = fieldWrapper.querySelector(".field-message");

      if (fieldMessage) {
        fieldMessage.textContent = message;
      }
    }

    function setSchoolSummary(school) {
      if (!school) {
        schoolSummary.hidden = true;
        return;
      }

      document.getElementById("summaryCode").textContent = school.code;
      document.getElementById("summaryType").textContent = school.type;
      document.getElementById("summaryName").textContent = school.name;
      document.getElementById("summaryLocation").textContent = school.location;
      document.getElementById("summaryStage").textContent = school.stage;
      document.getElementById("summaryRooms").textContent = school.rooms;
      document.getElementById("summaryStaff").textContent = school.staff;

      schoolSummary.hidden = false;
      refreshIcons();
    }

    function validateStep(step) {
      clearStepErrors(step);

      if (step === 1) {
        if (!scopeInput.value) {
          showStepError(
            1,
            "Selecione o âmbito institucional.",
            document.querySelector('[data-choice-group="scope"]')
          );
          return false;
        }

        if (!roleInput.value) {
          const firstRole = document.querySelector('[data-choice-group="role"]');

          showStepError(
            1,
            "Selecione a função que desempenha na instituição.",
            firstRole
          );

          return false;
        }

        return true;
      }

      if (step === 2) {
        if (!municipalityInput.value) {
          markFieldInvalid(
            municipalityInput,
            "Selecione o município."
          );

          showStepError(
            2,
            "Informe o município ou repartição.",
            municipalityInput
          );

          return false;
        }

        if (!schoolInput.value) {
          markFieldInvalid(
            schoolInput,
            "Selecione a unidade escolar."
          );

          showStepError(
            2,
            "Selecione a unidade escolar associada à sua conta.",
            schoolInput
          );

          return false;
        }

        return true;
      }

      if (step === 3) {
        const requiredFields = [
          [document.getElementById("bi"), "Informe o número do Bilhete de Identidade."],
          [document.getElementById("phone"), "Informe o seu telefone."],
          [document.getElementById("firstName"), "Informe o seu primeiro nome."],
          [document.getElementById("lastName"), "Informe o seu sobrenome."],
          [document.getElementById("email"), "Informe o seu e-mail institucional."],
          [document.getElementById("password"), "Defina uma senha."]
        ];

        for (const [field, message] of requiredFields) {
          if (!field.value.trim()) {
            markFieldInvalid(field, message);
            showStepError(3, message, field);
            return false;
          }
        }

        const email = document.getElementById("email");
        if (!email.validity.valid) {
          markFieldInvalid(email, "Informe um e-mail válido.");
          showStepError(3, "Informe um e-mail institucional válido.", email);
          return false;
        }

        const password = document.getElementById("password");
        const passwordConfirm = document.getElementById("passwordConfirm");

        if (password.value.length < 6) {
          markFieldInvalid(password, "A senha deve ter pelo menos 6 caracteres.");
          showStepError(
            3,
            "A senha deve ter pelo menos 6 caracteres.",
            password
          );
          return false;
        }

        if (!passwordConfirm.value.trim()) {
          markFieldInvalid(
            passwordConfirm,
            "Confirme a sua senha."
          );

          showStepError(
            3,
            "Confirme a sua senha.",
            passwordConfirm
          );

          return false;
        }

        if (password.value !== passwordConfirm.value) {
          markFieldInvalid(
            passwordConfirm,
            "As senhas não coincidem."
          );

          showStepError(
            3,
            "As senhas informadas não coincidem.",
            passwordConfirm
          );

          return false;
        }

        if (!termsInput.checked) {
          termsRow.classList.add("has-error");

          showStepError(
            3,
            "Aceite os termos de uso e a política de privacidade.",
            termsInput
          );

          return false;
        }

        return true;
      }

      return true;
    }

    document.querySelectorAll("[data-choice-group]").forEach((button) => {
      button.addEventListener("click", () => {
        const group = button.dataset.choiceGroup;
        const value = button.dataset.value;

        document.querySelectorAll(`[data-choice-group="${group}"]`).forEach((item) => {
          const selected = item === button;

          item.classList.toggle("is-selected", selected);
          item.setAttribute("aria-pressed", String(selected));
        });

        if (group === "scope") {
          scopeInput.value = value;
        }

        if (group === "role") {
          roleInput.value = value;
        }

        clearStepErrors(1);
      });
    });

    municipalityInput.addEventListener("change", () => {
      const options = schools[municipalityInput.value] || [];

      schoolInput.innerHTML = "";

      if (!options.length) {
        schoolInput.disabled = true;
        schoolInput.required = false;

        const option = document.createElement("option");
        option.value = "";
        option.textContent = "Nenhuma unidade encontrada";
        schoolInput.appendChild(option);

        setSchoolSummary(null);
        return;
      }

      const initialOption = document.createElement("option");
      initialOption.value = "";
      initialOption.textContent = "Selecione a unidade escolar";
      schoolInput.appendChild(initialOption);

      options.forEach((school) => {
        const option = document.createElement("option");
        option.value = school.value;
        option.textContent = `${school.name} (${school.code})`;
        schoolInput.appendChild(option);
      });

      schoolInput.disabled = false;
      schoolInput.required = true;
      setSchoolSummary(null);
    });

    schoolInput.addEventListener("change", () => {
      const selectedSchool = (schools[municipalityInput.value] || []).find(
        (school) => school.value === schoolInput.value
      );

      setSchoolSummary(selectedSchool || null);
      schoolInput.classList.remove("is-invalid");
      schoolInput.closest(".field")?.classList.remove("has-error");
    });

    document.querySelectorAll("input, select").forEach((field) => {
      field.addEventListener("input", () => {
        field.classList.remove("is-invalid");
        field.closest(".field")?.classList.remove("has-error");
      });

      field.addEventListener("change", () => {
        field.classList.remove("is-invalid");
        field.closest(".field")?.classList.remove("has-error");
      });
    });

    document.querySelectorAll("[data-next]").forEach((button) => {
      button.addEventListener("click", () => {
        if (!validateStep(currentStep)) {
          return;
        }

        currentStep += 1;
        renderStep();
      });
    });

    document.querySelectorAll("[data-prev]").forEach((button) => {
      button.addEventListener("click", () => {
        if (currentStep > 1) {
          currentStep -= 1;
          renderStep();
        }
      });
    });

    document.querySelectorAll("[data-password-toggle]").forEach((button) => {
      button.addEventListener("click", () => {
        const target = document.querySelector(button.dataset.passwordToggle);
        const shouldShow = target.type === "password";

        target.type = shouldShow ? "text" : "password";

        button.setAttribute(
          "aria-label",
          shouldShow ? "Ocultar senha" : "Mostrar senha"
        );

        button.setAttribute(
          "title",
          shouldShow ? "Ocultar senha" : "Mostrar senha"
        );

        button.innerHTML = `
          <i data-lucide="${shouldShow ? "eye-off" : "eye"}"></i>
        `;

        refreshIcons();
      });
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();

      if (!validateStep(3)) {
        return;
      }

      submitButton.disabled = true;
      submitButton.innerHTML = `
        <i data-lucide="loader-circle"></i>
        A enviar...
      `;

      refreshIcons();

      /*
        Em produção, substitua este bloco por um fetch para a sua API.
        Exemplo:
        fetch(form.action, {
          method: "POST",
          body: new FormData(form)
        });
      */

      window.setTimeout(() => {
        form.hidden = true;
        successState.hidden = false;
        submitButton.disabled = false;
      }, 700);
    });

    document.getElementById("editRegistration").addEventListener("click", () => {
      successState.hidden = true;
      form.hidden = false;
      currentStep = 3;
      renderStep();
    });

    refreshIcons();
  </script>
</body>
</html>
