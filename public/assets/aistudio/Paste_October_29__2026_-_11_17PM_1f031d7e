      *::before,
      *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
      }
    }
  </style>
</head>

<body>
  <header class="site-header">
    <div class="shell header-inner">
      <a class="brand" href="#catalogo" id="brand-link">
        <span class="brand-mark" aria-hidden="true">S</span>
        <span class="brand-copy">
          <strong>SIGRE</strong>
          <span>Quêssua · Educação</span>
        </span>
      </a>

      <nav class="main-nav" aria-label="Navegação principal">
        <button
          class="nav-button"
          type="button"
          data-view="catalogo"
          aria-current="page"
        >
          <i data-lucide="layout-grid" aria-hidden="true"></i>
          <span>Catálogo</span>
        </button>

        <button class="nav-button" type="button" data-view="pedidos">
          <i data-lucide="folder-open" aria-hidden="true"></i>
          <span>Meus pedidos</span>
          <span class="nav-count" id="draft-count" aria-label="0 rascunhos">0</span>
        </button>
      </nav>
    </div>
  </header>

  <main class="shell">
    <noscript>
      <p class="notice" style="margin-top: 24px;">
        É necessário ativar o JavaScript para utilizar o catálogo.
      </p>
    </noscript>

    <section class="page" id="catalogo" aria-labelledby="catalog-title">
      <div class="page-heading">
        <div>
          <p class="eyebrow">Serviços municipais</p>
          <h1 id="catalog-title" tabindex="-1">Catálogo de serviços</h1>
          <p class="page-description">
            Encontre o documento que precisa e inicie o seu pedido.
          </p>
        </div>
      </div>

      <div class="toolbar">
        <div class="search-box">
          <i data-lucide="search" aria-hidden="true"></i>

          <label class="sr-only" for="search">
            Pesquisar serviços
          </label>

          <input
            id="search"
            type="search"
            placeholder="Pesquisar um serviço"
            autocomplete="off"
          >

          <button
            class="icon-button"
            type="button"
            id="clear-search"
            aria-label="Limpar pesquisa"
            title="Limpar pesquisa"
            hidden
          >
            <i data-lucide="x" aria-hidden="true"></i>
            <span class="fallback-icon" aria-hidden="true">&times;</span>
          </button>
        </div>

        <div class="filters" role="group" aria-label="Filtrar por público">
          <button
            class="filter-button"
            type="button"
            data-filter="todos"
            aria-pressed="true"
          >
            Todos
          </button>

          <button
            class="filter-button"
            type="button"
            data-filter="funcionarios"
            aria-pressed="false"
          >
            Funcionários
          </button>

          <button
            class="filter-button"
            type="button"
            data-filter="escolares"
            aria-pressed="false"
          >
            Alunos e encarregados
          </button>
        </div>
      </div>

      <div class="section-heading">
        <h2>Serviços disponíveis</h2>
