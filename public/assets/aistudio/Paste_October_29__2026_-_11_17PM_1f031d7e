    <section class="page" id="pedidos" aria-labelledby="drafts-title" hidden>
      <div class="page-heading">
        <div>
          <p class="eyebrow">Acompanhamento</p>
          <h1 id="drafts-title" tabindex="-1">Meus pedidos</h1>
          <p class="page-description">
            Consulte e edite os seus rascunhos.
          </p>
        </div>

        <button
          class="button button-secondary"
          type="button"
          data-open-catalog
        >
          <i data-lucide="arrow-left" aria-hidden="true"></i>
          Voltar ao catálogo
        </button>
      </div>

      <div class="notice draft-notice">
        <i data-lucide="info" aria-hidden="true"></i>
        <p>
          Estes rascunhos existem apenas enquanto esta página estiver aberta.
          Ainda não foram enviados.
        </p>
      </div>

      <ul class="draft-list" id="draft-list"></ul>

      <div class="empty-state" id="no-drafts">
        <div class="empty-icon">
          <i data-lucide="folder-open" aria-hidden="true"></i>
        </div>

        <h2>Nenhum pedido por enquanto</h2>
        <p>Os seus rascunhos aparecerão aqui.</p>

        <button
          class="button button-primary"
          type="button"
          data-open-catalog
        >
          Explorar serviços
          <i data-lucide="arrow-right" aria-hidden="true"></i>
        </button>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-inner">
      <span><strong>SIGRE</strong> · Quêssua</span>
      <span>Direcção Municipal da Educação</span>
    </div>
  </footer>

  <dialog
    id="request-dialog"
    aria-labelledby="dialog-title"
    aria-describedby="dialog-destination"
  >
    <form id="request-form">
      <div class="dialog-header">
        <div>
          <h2 id="dialog-title">Novo rascunho</h2>
          <p class="dialog-service" id="dialog-service"></p>
          <p class="dialog-destination" id="dialog-destination"></p>
        </div>

        <button
          class="icon-button"
          type="button"
          id="close-dialog"
          aria-label="Fechar formulário"
          title="Fechar formulário"
        >
          <i data-lucide="x" aria-hidden="true"></i>
          <span class="fallback-icon" aria-hidden="true">&times;</span>
        </button>
      </div>

      <div class="dialog-body">
        <div class="notice">
          <i data-lucide="info" aria-hidden="true"></i>
          <p>
            Demonstração: o rascunho não será enviado e desaparecerá
            ao atualizar ou fechar a página.
          </p>
        </div>

        <div class="form-grid">
          <div class="field">
            <label for="requester">
              Nome do requerente <span class="required">*</span>
            </label>
            <input
              id="requester"
              name="requester"
              type="text"
              autocomplete="name"
              minlength="2"
              maxlength="120"
              required
            >
          </div>

          <div class="field">
            <label for="phone">
              Telefone para contacto <span class="required">*</span>
            </label>
            <input
              id="phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              inputmode="tel"
              maxlength="25"
              required
              aria-describedby="phone-hint"
            >
            <p class="field-hint" id="phone-hint">
              Inclua o indicativo, se necessário.
            </p>
          </div>

          <div class="field field-full" data-extra="workplace" hidden>
            <label for="workplace">
              Local de trabalho <span class="required">*</span>
            </label>
            <input
              id="workplace"
              name="workplace"
              type="text"
              minlength="2"
              maxlength="120"
              required
              disabled
            >
          </div>

          <div class="field" data-extra="student" hidden>
            <label for="student">
              Nome do aluno <span class="required">*</span>
            </label>
            <input
              id="student"
              name="student"
              type="text"
              minlength="2"
              maxlength="120"
              required
              disabled
            >
          </div>

          <div class="field" data-extra="school" hidden>
            <label for="school">
              Escola de origem <span class="required">*</span>
            </label>
            <input
              id="school"
              name="school"
              type="text"
              minlength="2"
              maxlength="120"
              required
              disabled
            >
          </div>

          <div class="field" data-extra="term" hidden>
            <label for="term">
              Trimestre <span class="required">*</span>
            </label>
            <select id="term" name="term" required disabled>
              <option value="">Selecionar</option>
              <option value="1">1.º trimestre</option>
              <option value="2">2.º trimestre</option>
              <option value="3">3.º trimestre</option>
            </select>
          </div>

          <div class="field" data-extra="year" hidden>
            <label for="year">
              Ano letivo <span class="required">*</span>
            </label>
            <input
              id="year"
              name="year"
              type="number"
              inputmode="numeric"
              min="1900"
              max="2100"
              step="1"
              required
              disabled
            >
          </div>

          <div class="field field-full" data-extra="destinationSchool" hidden>
            <label for="destination-school">
              Escola de destino pretendida <span class="required">*</span>
            </label>
            <input
              id="destination-school"
              name="destinationSchool"
              type="text"
              minlength="2"
              maxlength="120"
              required
              disabled
            >
          </div>

          <div class="field field-full">
            <label for="notes">Observações <span class="field-hint">(opcional)</span></label>
            <textarea
              id="notes"
              name="notes"
              maxlength="500"
            ></textarea>
          </div>
        </div>

        <p class="form-error" id="form-error" role="alert" hidden></p>
      </div>

      <div class="dialog-footer">
        <button class="button button-secondary" type="button" id="cancel-dialog">
          Cancelar
        </button>

        <button class="button button-primary" type="submit">
          <i data-lucide="save" aria-hidden="true"></i>
          Guardar rascunho
        </button>
      </div>
    </form>
  </dialog>

  <script>
    (() => {
      "use strict";

      /*
       * Os serviços são definidos uma única vez.
       * A mesma lista alimenta o catálogo, os filtros e os formulários.
       */
      const services = [
        {
          id: "efetividade",
          title: "Declaração de Efectividade",
          description: "Comprovativo de vínculo e exercício de funções.",
          category: "funcionarios",
          categoryLabel: "Funcionários",
          destination: "Direcção Municipal da Educação",
          icon: "building-2",
          fields: ["workplace"]
        },
        {
          id: "servico",
          title: "Declaração de Serviço",
          description: "Comprovativo de serviço para fins bancários ou salariais.",
          category: "funcionarios",
          categoryLabel: "Funcionários",
          destination: "Direcção Municipal da Educação",
          icon: "landmark",
          fields: ["workplace"]
        },
        {
          id: "boletim",
          title: "Boletim de Notas Trimestral",
          description: "Pedido de cópia do boletim com as notas do trimestre.",
          category: "escolares",
          categoryLabel: "Alunos e encarregados",
          destination: "Direcção da escola",
          icon: "graduation-cap",
          fields: ["student", "school", "term", "year"]
        },
        {
          id: "matricula",
          title: "Declaração ou Atestado de Matrícula",
          description: "Comprovativo de matrícula e frequência escolar.",
          category: "escolares",
          categoryLabel: "Alunos e encarregados",
          destination: "Secretaria da escola",
          icon: "file-check",
          fields: ["student", "school"]
        },
        {
          id: "transferencia",
          title: "Guia de Transferência Escolar",
          description: "Pedido de transferência entre escolas da rede municipal.",
          category: "escolares",
          categoryLabel: "Alunos e encarregados",
          destination: "Escolas e Direcção Municipal da Educação",
          icon: "arrow-left-right",
          fields: ["student", "school", "destinationSchool"]
        }
      ];

      const serviceById = new Map(
        services.map((service) => [service.id, service])
      );

      const state = {
        filter: "todos",
        drafts: [],
        nextDraftId: 1,
        currentService: null,
        editingId: null,
        dialogDirty: false,
        dialogTrigger: null
      };

      const elements = {
        catalog: document.getElementById("catalogo"),
        draftsPage: document.getElementById("pedidos"),
        catalogTitle: document.getElementById("catalog-title"),
        draftsTitle: document.getElementById("drafts-title"),
        search: document.getElementById("search"),
        clearSearch: document.getElementById("clear-search"),
        serviceList: document.getElementById("service-list"),
        resultCount: document.getElementById("result-count"),
        noResults: document.getElementById("no-results"),
        resetFilters: document.getElementById("reset-filters"),
        draftList: document.getElementById("draft-list"),
        draftCount: document.getElementById("draft-count"),
        noDrafts: document.getElementById("no-drafts"),
        dialog: document.getElementById("request-dialog"),
        dialogTitle: document.getElementById("dialog-title"),
        dialogService: document.getElementById("dialog-service"),
        dialogDestination: document.getElementById("dialog-destination"),
        form: document.getElementById("request-form"),
        formError: document.getElementById("form-error"),
        closeDialog: document.getElementById("close-dialog"),
        cancelDialog: document.getElementById("cancel-dialog")
      };

      const escapeHtml = (value) => {
        const replacements = {
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;"
        };

        return String(value ?? "").replace(
          /[&<>"']/g,
          (character) => replacements[character]
        );
      };

      const normalize = (value) => String(value ?? "")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .trim()
        .replace(/\s+/g, " ");

      function icon(name) {
        return `<i data-lucide="${escapeHtml(name)}" aria-hidden="true"></i>`;
      }

      window.renderLucide = () => {
        if (!window.lucide || typeof window.lucide.createIcons !== "function") {
          return;
        }

        window.lucide.createIcons();
        document.documentElement.classList.add("icons-ready");
      };

      function setView(view, moveFocus = false) {
        const showCatalog = view === "catalogo";

        elements.catalog.hidden = !showCatalog;
        elements.draftsPage.hidden = showCatalog;

        document.querySelectorAll("[data-view]").forEach((button) => {
          if (button.dataset.view === view) {
            button.setAttribute("aria-current", "page");
          } else {
            button.removeAttribute("aria-current");
          }
        });

        if (moveFocus) {
          const heading = showCatalog
            ? elements.catalogTitle
            : elements.draftsTitle;

          heading.focus();
        }
      }

      function renderServices() {
        const query = normalize(elements.search.value);

        const matchingServices = services.filter((service) => {
          const matchesFilter =
            state.filter === "todos" || service.category === state.filter;

          const searchableText = normalize([
            service.title,
            service.description,
            service.categoryLabel,
            service.destination
          ].join(" "));

          return matchesFilter && searchableText.includes(query);
        });

        elements.serviceList.innerHTML = matchingServices.map((service) => {
          const schoolClass = service.category === "escolares" ? "school" : "";

          return `
            <li class="service-card">
              <div class="service-icon ${schoolClass}">
                ${icon(service.icon)}
              </div>

              <div class="service-content">
                <h3>${escapeHtml(service.title)}</h3>
                <p class="service-description">
                  ${escapeHtml(service.description)}
                </p>

                <div class="service-meta">
                  <span class="category-label">
                    ${escapeHtml(service.categoryLabel)}
                  </span>

                  <span class="destination">
                    ${icon("map-pin")}
                    <span>${escapeHtml(service.destination)}</span>
                  </span>
                </div>
              </div>

              <button
                class="button button-secondary service-action"
                type="button"
                data-service="${escapeHtml(service.id)}"
                aria-label="Solicitar ${escapeHtml(service.title)}"
              >
                Solicitar
                ${icon("arrow-right")}
              </button>
            </li>
          `;
        }).join("");

        const count = matchingServices.length;
        elements.resultCount.textContent =
          count === 1 ? "1 serviço" : `${count} serviços`;

        elements.noResults.hidden = count !== 0;
        elements.clearSearch.hidden = elements.search.value.length === 0;

        document.querySelectorAll("[data-filter]").forEach((button) => {
          button.setAttribute(
            "aria-pressed",
            String(button.dataset.filter === state.filter)
          );
        });

        window.renderLucide();
      }

      function formatDate(date) {
        return new Intl.DateTimeFormat("pt-PT", {
          day: "2-digit",
          month: "2-digit",
          year: "numeric",
          hour: "2-digit",
          minute: "2-digit"
        }).format(date);
      }

      function renderDrafts() {
        const count = state.drafts.length;

        elements.draftCount.textContent = String(count);
        elements.draftCount.setAttribute(
          "aria-label",
          count === 1 ? "1 rascunho" : `${count} rascunhos`
        );

        elements.noDrafts.hidden = count !== 0;

        elements.draftList.innerHTML = state.drafts.map((draft) => {
          const service = serviceById.get(draft.serviceId);
          if (!service) return "";

          return `
            <li class="draft-card">
              <div class="draft-content">
                <h3>${escapeHtml(service.title)}</h3>

                <div class="draft-meta">
                  <span class="draft-status">Rascunho</span>
                  <span>Requerente: ${escapeHtml(draft.values.requester)}</span>
                  <span>Atualizado em ${escapeHtml(formatDate(draft.updatedAt))}</span>
                </div>
              </div>

              <div class="draft-actions">
                <button
                  class="button button-secondary"
                  type="button"
                  data-draft-action="edit"
                  data-draft-id="${draft.id}"
                  aria-label="Editar rascunho de ${escapeHtml(service.title)}"
                >
                  ${icon("pencil")}
                  Editar
                </button>

                <button
                  class="button button-danger"
                  type="button"
                  data-draft-action="delete"
                  data-draft-id="${draft.id}"
                  aria-label="Eliminar rascunho de ${escapeHtml(service.title)}"
                >
                  ${icon("trash-2")}
                  Eliminar
                </button>
              </div>
            </li>
          `;
        }).join("");

        window.renderLucide();
      }

      function openRequest(service, draft = null, trigger = null) {
        state.currentService = service;
        state.editingId = draft ? draft.id : null;
        state.dialogDirty = false;
        state.dialogTrigger = trigger;

        elements.form.reset();
        elements.formError.hidden = true;
        elements.formError.textContent = "";

        elements.form.querySelectorAll("input, select, textarea").forEach((field) => {
          field.setCustomValidity("");
        });

        document.querySelectorAll("[data-extra]").forEach((wrapper) => {
          const enabled = service.fields.includes(wrapper.dataset.extra);
          const field = wrapper.querySelector("input, select, textarea");

          wrapper.hidden = !enabled;
          field.disabled = !enabled;
        });

        if (draft) {
          Object.entries(draft.values).forEach(([name, value]) => {
            const field = elements.form.elements.namedItem(name);
            if (field && !field.disabled) field.value = value;
          });
        }

        elements.dialogTitle.textContent = draft
          ? "Editar rascunho"
          : "Novo rascunho";

        elements.dialogService.textContent = service.title;
        elements.dialogDestination.textContent =
          `Destino previsto: ${service.destination}`;

        elements.dialog.showModal();
        document.getElementById("requester").focus();
      }

      function requestDialogClose() {
        if (
          state.dialogDirty &&
          !window.confirm("Descartar as alterações não guardadas?")
        ) {
          return;
        }

        elements.dialog.close();
      }

      function fingerprint(serviceId, values) {
        return JSON.stringify([
          serviceId,
          normalize(values.requester),
          String(values.phone ?? "").replace(/\D/g, ""),
          normalize(values.workplace),
          normalize(values.student),
          normalize(values.school),
          normalize(values.term),
          normalize(values.year),
          normalize(values.destinationSchool)
        ]);
      }

      document.querySelectorAll("[data-view]").forEach((button) => {
        button.addEventListener("click", () => {
          setView(button.dataset.view);
        });
      });

      document.querySelectorAll("[data-open-catalog]").forEach((button) => {
        button.addEventListener("click", () => {
          setView("catalogo", true);
        });
      });

      document.getElementById("brand-link").addEventListener("click", (event) => {
        event.preventDefault();
        setView("catalogo", true);
      });

      document.querySelectorAll("[data-filter]").forEach((button) => {
        button.addEventListener("click", () => {
          state.filter = button.dataset.filter;
          renderServices();
        });
      });

      elements.search.addEventListener("input", renderServices);

      elements.search.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && elements.search.value) {
          elements.search.value = "";
          renderServices();
        }
      });

      elements.clearSearch.addEventListener("click", () => {
        elements.search.value = "";
        renderServices();
        elements.search.focus();
      });

      elements.resetFilters.addEventListener("click", () => {
        state.filter = "todos";
        elements.search.value = "";
        renderServices();
        elements.search.focus();
      });

      elements.serviceList.addEventListener("click", (event) => {
        const button = event.target.closest("[data-service]");
        if (!button) return;

        const service = serviceById.get(button.dataset.service);
        if (service) openRequest(service, null, button);
      });

      elements.draftList.addEventListener("click", (event) => {
        const button = event.target.closest("[data-draft-action]");
        if (!button) return;

        const id = Number(button.dataset.draftId);
        const draft = state.drafts.find((item) => item.id === id);
        if (!draft) return;

        if (button.dataset.draftAction === "edit") {
          const service = serviceById.get(draft.serviceId);
          if (service) openRequest(service, draft, button);
        }

        if (button.dataset.draftAction === "delete") {
          if (!window.confirm("Eliminar este rascunho?")) return;

          state.drafts = state.drafts.filter((item) => item.id !== id);
          renderDrafts();
          elements.draftsTitle.focus();
        }
      });

      elements.closeDialog.addEventListener("click", requestDialogClose);
      elements.cancelDialog.addEventListener("click", requestDialogClose);

      elements.dialog.addEventListener("cancel", (event) => {
        event.preventDefault();
        requestDialogClose();
      });

      elements.dialog.addEventListener("close", () => {
        const trigger = state.dialogTrigger;

        if (trigger && trigger.isConnected && trigger.getClientRects().length) {
          trigger.focus();
        }

        state.dialogTrigger = null;
      });

      elements.form.addEventListener("input", (event) => {
        if (typeof event.target.setCustomValidity === "function") {
          event.target.setCustomValidity("");
        }

        state.dialogDirty = true;
        elements.formError.hidden = true;
      });

      elements.form.addEventListener("change", () => {
        state.dialogDirty = true;
        elements.formError.hidden = true;
      });

      elements.form.addEventListener("submit", (event) => {
        event.preventDefault();

        elements.form.querySelectorAll("input, textarea").forEach((field) => {
          if (!field.disabled) field.value = field.value.trim();
        });

        const phone = elements.form.elements.namedItem("phone");
        const digits = phone.value.replace(/\D/g, "");
        const validCharacters = /^\+?[\d\s()-]+$/.test(phone.value);

        phone.setCustomValidity(
          validCharacters && digits.length >= 7 && digits.length <= 15
            ? ""
            : "Introduza um telefone válido, com 7 a 15 algarismos."
        );

        if (!elements.form.reportValidity()) return;

        const values = Object.fromEntries(new FormData(elements.form).entries());
        const key = fingerprint(state.currentService.id, values);

        const duplicate = state.drafts.find((draft) => (
          draft.id !== state.editingId &&
          fingerprint(draft.serviceId, draft.values) === key
        ));

        if (duplicate) {
          elements.formError.textContent =
            "Já existe um rascunho com estes dados. Pode editá-lo em Meus pedidos.";
          elements.formError.hidden = false;
          return;
        }

        const now = new Date();

        if (state.editingId !== null) {
          const existing = state.drafts.find(
            (draft) => draft.id === state.editingId
          );

          if (!existing) {
            elements.formError.textContent =
              "Não foi possível encontrar este rascunho.";
            elements.formError.hidden = false;
            return;
          }

          existing.values = values;
          existing.updatedAt = now;
        } else {
          state.drafts.unshift({
            id: state.nextDraftId++,
            serviceId: state.currentService.id,
            values,
            updatedAt: now
          });
        }

        state.dialogDirty = false;
        elements.dialog.close();
        renderDrafts();
        setView("pedidos", true);
      });

      window.addEventListener("beforeunload", (event) => {
        if (state.drafts.length > 0 || state.dialogDirty) {
          event.preventDefault();
          event.returnValue = "";
        }
      });

      renderServices();
      renderDrafts();

      /*
       * O catálogo e os formulários continuam a funcionar se os ícones
       * não puderem ser carregados.
       */
      const iconScript = document.createElement("script");
      iconScript.src =
        "https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js";
      iconScript.async = true;
      iconScript.onload = window.renderLucide;
      document.head.appendChild(iconScript);
    })();
  </script>
</body>
</html>
```

A prevenção de duplicados atua somente nos rascunhos desta página. Na integração real, a validação também deve existir no servidor. Não consegui executar testes de navegador neste ambiente.