  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      lucide.createIcons();

      const sidebar = document.getElementById("sidebar");
      const sidebarOverlay = document.getElementById("sidebarOverlay");
      const menuToggle = document.getElementById("menuToggle");

      const notificationsButton = document.getElementById("notificationsButton");
      const notificationsPanel = document.getElementById("notificationsPanel");

      const profileButton = document.getElementById("profileButton");
      const profilePanel = document.getElementById("profilePanel");

      const toast = document.getElementById("toast");
      const refreshButton = document.getElementById("refreshButton");
      const lastUpdated = document.getElementById("lastUpdated");

      let toastTimer;

      function showToast(message) {
        clearTimeout(toastTimer);

        toast.textContent = message;
        toast.classList.add("visible");

        toastTimer = setTimeout(function () {
          toast.classList.remove("visible");
        }, 3000);
      }

      function closeSidebar() {
        sidebar.classList.remove("is-open");
        sidebarOverlay.classList.remove("is-visible");
        document.body.classList.remove("menu-open");
        menuToggle.setAttribute("aria-expanded", "false");
      }

      function closePopovers() {
        notificationsPanel.hidden = true;
        profilePanel.hidden = true;

        notificationsButton.setAttribute("aria-expanded", "false");
        profileButton.setAttribute("aria-expanded", "false");
      }

      function togglePopover(panel, button) {
        const shouldOpen = panel.hidden;

        closePopovers();

        panel.hidden = !shouldOpen;
        button.setAttribute("aria-expanded", String(shouldOpen));
      }

      menuToggle.addEventListener("click", function () {
        const isOpen = sidebar.classList.toggle("is-open");

        sidebarOverlay.classList.toggle("is-visible", isOpen);
        document.body.classList.toggle("menu-open", isOpen);
        menuToggle.setAttribute("aria-expanded", String(isOpen));
      });

      sidebarOverlay.addEventListener("click", closeSidebar);

      notificationsButton.addEventListener("click", function (event) {
        event.stopPropagation();
        togglePopover(notificationsPanel, notificationsButton);
      });

      profileButton.addEventListener("click", function (event) {
        event.stopPropagation();
        togglePopover(profilePanel, profileButton);
      });

      document.addEventListener("click", function (event) {
        if (
          !event.target.closest("#notificationsPanel") &&
          !event.target.closest("#notificationsButton") &&
          !event.target.closest("#profilePanel") &&
          !event.target.closest("#profileButton")
        ) {
          closePopovers();
        }
      });

      document.querySelectorAll(".nav-link").forEach(function (link) {
        link.addEventListener("click", function () {
          document.querySelectorAll(".nav-link").forEach(function (item) {
            item.classList.remove("active");
            item.removeAttribute("aria-current");
          });

          link.classList.add("active");
          link.setAttribute("aria-current", "page");

          if (window.innerWidth <= 860) {
            closeSidebar();
          }
        });
      });

      document.querySelectorAll("[data-toast]").forEach(function (element) {
        element.addEventListener("click", function (event) {
          if (element.tagName.toLowerCase() === "a") {
            event.preventDefault();
          }

          showToast(element.dataset.toast);
        });
      });

      refreshButton.addEventListener("click", function () {
        refreshButton.classList.add("is-loading");
        showToast("Indicadores actualizados.");

        setTimeout(function () {
          refreshButton.classList.remove("is-loading");

          const now = new Intl.DateTimeFormat("pt-PT", {
            hour: "2-digit",
            minute: "2-digit"
          }).format(new Date());

          lastUpdated.textContent = "Actualizado às " + now;
        }, 700);
      });

      const currentDate = new Intl.DateTimeFormat("pt-PT", {
        day: "2-digit",
        month: "long",
        year: "numeric"
      }).format(new Date());

      document.title = "SIGRE — Visão geral · " + currentDate;
    });
  </script>
</body>
