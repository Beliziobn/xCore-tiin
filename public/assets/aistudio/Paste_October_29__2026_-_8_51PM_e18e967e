          <article class="panel">
            <div class="panel-heading">
              <div>
                <span class="eyebrow">Acesso rápido</span>
                <h2>Acções frequentes</h2>
              </div>
            </div>

            <div class="quick-actions">
              <div class="action-row">
                <span class="action-icon">
                  <i data-lucide="users"></i>
                </span>

                <span class="action-copy">
                  <strong>Adicionar professor</strong>
                  <small>Registar novo docente na rede</small>
                </span>

                <button
                  class="action-arrow"
                  type="button"
                  aria-label="Adicionar professor"
                  data-toast="O formulário de novo professor será aberto."
                >
                  <i data-lucide="plus"></i>
                </button>
              </div>

              <div class="action-row">
                <span class="action-icon">
                  <i data-lucide="layers"></i>
                </span>

                <span class="action-copy">
                  <strong>Configurar turmas</strong>
                  <small>Organizar classes e períodos</small>
                </span>

                <button
                  class="action-arrow"
                  type="button"
                  aria-label="Configurar turmas"
                  data-toast="A configuração de turmas será aberta."
                >
                  <i data-lucide="arrow-up-right"></i>
                </button>
              </div>

              <div class="action-row">
                <span class="action-icon">
                  <i data-lucide="file-text"></i>
                </span>

                <span class="action-copy">
                  <strong>Gerar relatório</strong>
                  <small>Consultar resumo da rede escolar</small>
                </span>

                <button
                  class="action-arrow"
                  type="button"
                  aria-label="Gerar relatório"
                  data-toast="O relatório está a ser preparado."
                >
                  <i data-lucide="download"></i>
                </button>
              </div>

              <div class="action-row">
                <span class="action-icon">
                  <i data-lucide="calendar-days"></i>
                </span>

                <span class="action-copy">
                  <strong>Abrir calendário</strong>
                  <small>Consultar agenda e actividades</small>
                </span>

                <button
                  class="action-arrow"
                  type="button"
                  aria-label="Abrir calendário"
                  data-toast="O calendário será aberto."
                >
                  <i data-lucide="arrow-up-right"></i>
                </button>
              </div>
            </div>
