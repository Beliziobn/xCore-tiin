              >
                <i data-lucide="more-horizontal"></i>
              </button>
            </div>

            <div class="network-summary">
              <div class="summary-number">
                1 <span>escola activa</span>
              </div>

              <span class="state-badge warning">
                <i data-lucide="triangle-alert"></i>
                Configuração pendente
              </span>
            </div>

            <div class="progress-list">
              <div class="progress-row">
                <div class="progress-label">
                  <span>Escolas registadas</span>
                  <strong>1 de 1</strong>
                </div>

                <div class="progress-track">
                  <div class="progress-value green" style="width: 100%;"></div>
                </div>
              </div>

              <div class="progress-row">
                <div class="progress-label">
                  <span>Professores homologados</span>
                  <strong>32 de 32</strong>
                </div>

                <div class="progress-track">
                  <div class="progress-value green" style="width: 100%;"></div>
                </div>
              </div>

              <div class="progress-row">
                <div class="progress-label">
                  <span>Turmas configuradas</span>
                  <strong>0 de 0</strong>
                </div>

                <div class="progress-track">
                  <div class="progress-value gray" style="width: 4%;"></div>
                </div>
              </div>

              <div class="progress-row">
                <div class="progress-label">
                  <span>Dados de presença</span>
                  <strong>Sem dados</strong>
                </div>

                <div class="progress-track">
                  <div class="progress-value gray" style="width: 0%;"></div>
                </div>
              </div>
            </div>
