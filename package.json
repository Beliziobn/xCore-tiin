    "@types/node": ">=22.0.0",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.20",
    "esbuild": ">=0.24.0",
    "tailwindcss": ">=4.0.0",
    "tsx": ">=4.19.0",
    "typescript": "~5.8.2",
    "vite": ">=6.0.0"
