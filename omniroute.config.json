{
  "$schema": "https://raw.githubusercontent.com/omniroute/schema/main/config.schema.json",
  "version": "1.0",
  "name": "uCore AI Gateway",
  "server": {
    "port": 4000,
    "host": "127.0.0.1",
    "cors": true
  },
  "routing": {
    "strategy": "headroom-based",
    "description": "Monitora continuamente a capacidade de contexto e custos, preservando uma margem segura de headroom para evitar corte de tokens e degradação de raciocínio.",
    "headroom": {
      "safetyMarginPercent": 25,
      "criticalThresholdTokens": 8000,
      "autoCompressWhenHeadroomBelowPercent": 30,
      "fallbackOnExhaustion": true
    },
    "defaultTier": "balanced",
    "tiers": {
      "fast": {
        "models": ["claude-3-5-haiku-latest", "gemini-2.0-flash"],
        "maxInputTokens": 100000,
        "temperature": 0.2
      },
      "balanced": {
        "models": ["claude-3-7-sonnet-latest", "claude-3-5-sonnet-latest"],
        "maxInputTokens": 180000,
        "temperature": 0.4
      },
      "deep_reasoning": {
        "models": ["claude-3-7-sonnet-thought", "claude-3-opus-latest"],
        "maxInputTokens": 200000,
        "temperature": 0.5
      }
    },
    "fallbackChain": [
      "claude-3-7-sonnet-latest",
      "claude-3-5-sonnet-latest",
      "claude-3-5-haiku-latest"
    ]
  },
  "compression": {
    "enabled": true,
    "algorithm": "semantic-deduplication",
    "pruneRedundantToolOutputs": true,
    "compressStackTraces": true,
    "targetReductionPercent": 40
  },
  "cache": {
    "enabled": true,
    "ttlSeconds": 3600,
    "matchStrategy": "semantic-hash"
  },
  "logging": {
    "level": "info",
    "logTokensUsed": true,
    "logHeadroomMetrics": true
  }
}
