{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil de usuário institucional da plataforma uCore com restrições de permissão e RLS",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID do usuário do Firebase Authentication",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Endereço de e-mail institucional do usuário",
          "maxLength": 120
        },
        "firstName": {
          "type": "string",
          "description": "Primeiro nome do usuário",
          "maxLength": 80
        },
        "lastName": {
          "type": "string",
          "description": "Sobrenome ou apelido do usuário",
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "description": "Perfil base de acesso ao sistema com privilégios restritos",
          "enum": ["admin", "diretor", "professor", "custom"],
          "maxLength": 30
        },
        "scope": {
          "type": "string",
          "description": "Âmbito de atuação institucional",
          "enum": ["escola", "administracao"],
          "maxLength": 30
        },
        "schoolRole": {
          "type": "string",
          "description": "Cargo específico escolar",
          "maxLength": 50
        },
        "adminRole": {
          "type": "string",
          "description": "Cargo específico na administração municipal",
          "maxLength": 50
        },
        "cargoTitle": {
          "type": "string",
          "description": "Título por extenso da função",
          "maxLength": 120
        },
        "schoolName": {
          "type": "string",
          "description": "Nome da unidade escolar vinculada (FK)",
          "maxLength": 150
        },
        "municipalityOrDepartment": {
          "type": "string",
          "description": "Município ou departamento institucional",
          "maxLength": 150
        },
        "titlePrefix": {
          "type": "string",
          "description": "Prefixo de tratamento",
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "description": "Status de validação da conta",
          "enum": ["ativo", "pendente", "validado", "em_analise"],
          "maxLength": 30
        },
        "accountValidated": {
          "type": "boolean",
          "description": "Indica se a conta foi validada institucionalmente pela Direção ou DME"
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Indica se o e-mail foi verificado via Firebase Auth"
        },
        "createdAt": {
          "type": "string",
          "description": "Data ISO de criação da conta",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "Data ISO da última atualização",
          "maxLength": 50
        }
      },
      "required": ["userId", "email", "firstName", "role", "status", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Registo de administradores do sistema uCore com acesso privilegiado",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID do usuário administrador",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "E-mail do administrador",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "description": "Data de promoção a admin",
          "maxLength": 50
        }
      },
      "required": ["userId", "email", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Registo imutável de trilha de auditoria para ações críticas e segurança (SSD)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador único do log de auditoria",
          "maxLength": 128
        },
        "action": {
          "type": "string",
          "description": "Tipo de evento de auditoria",
          "maxLength": 60
        },
        "severity": {
          "type": "string",
          "description": "Nível de severidade do evento",
          "enum": ["INFO", "WARNING", "CRITICAL"],
          "maxLength": 20
        },
        "actorId": {
          "type": "string",
          "description": "ID do usuário autor da ação",
          "maxLength": 128
        },
        "actorRole": {
          "type": "string",
          "description": "Cargo/Papel do autor da ação",
          "maxLength": 50
        },
        "targetId": {
          "type": "string",
          "description": "ID da entidade alvo",
          "maxLength": 128
        },
        "targetType": {
          "type": "string",
          "description": "Tipo da entidade alvo",
          "maxLength": 50
        },
        "details": {
          "type": "string",
          "description": "Descrição detalhada da ação realizada",
          "maxLength": 500
        },
        "timestamp": {
          "type": "string",
          "description": "Carimbo de data/hora ISO 8601 do evento",
          "maxLength": 50
        }
      },
      "required": ["id", "action", "actorId", "actorRole", "details", "timestamp"]
    },
    "Student": {
      "title": "Student",
      "description": "Registo do estudante com constraints de validação e chave estrangeira para escola e turma",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador único do estudante",
          "maxLength": 128
        },
        "nomeCompleto": {
          "type": "string",
          "description": "Nome completo do estudante",
          "maxLength": 120
        },
        "numeroDocumento": {
          "type": "string",
          "description": "Número do BI ou Cédula com constraint",
          "maxLength": 30
        },
        "schoolId": {
          "type": "string",
          "description": "Chave Estrangeira (FK) referenciando a Escola",
          "maxLength": 128
        },
        "turma": {
          "type": "string",
          "description": "Turma do estudante",
          "maxLength": 50
        },
        "classe": {
          "type": "string",
          "description": "Classe do estudante",
          "maxLength": 50
        },
        "dataNascimento": {
          "type": "string",
          "description": "Data de nascimento do aluno",
          "maxLength": 30
        },
        "genero": {
          "type": "string",
          "enum": ["M", "F", "Outro"],
          "maxLength": 10
        }
      },
      "required": ["id", "nomeCompleto", "schoolId", "turma", "classe"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Contas de usuários institucionais e estado de validação com RLS estrito"
    },
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/Admin"
      },
      "description": "Registro restrito de permissões de administrador de sistema"
    },
    "/audit_logs/{logId}": {
      "schema": {
        "$ref": "#/entities/AuditLog"
      },
      "description": "Trilha imutável de auditoria, append-only e leitura exclusiva de administradores"
    },
    "/students/{studentId}": {
      "schema": {
        "$ref": "#/entities/Student"
      },
      "description": "Registo de alunos vinculados a escolas e turmas com integridade referencial"
    }
  }
}
